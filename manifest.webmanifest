    { "src": "screenshot-calendar.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "All 75 days, coloured by score" },
    { "src": "screenshot-progress.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Streak, good days and habit hit-rates" }
